{
  "name": "@sneeai/sneeai-agent",
  "version": "0.3.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sneeai-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "README.md"
  ],
  "scripts": {
