  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://sneeai.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sneeai/sneeai-agent.git",
    "directory": "canvas-agent"
  },
  "bugs": {
